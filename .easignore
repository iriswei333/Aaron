# Dependencies & caches (EAS installs these itself)
node_modules/
**/node_modules/
.turbo/
.cache/
.expo/
**/.expo/
dist/
web-build/

# Web app: keep only package.json so npm workspaces + lockfile still resolve
apps/web/*
!apps/web/package.json

# Native folders: generated by prebuild on EAS from app.json
apps/mobile/android/
apps/mobile/ios/

# Build outputs & local artifacts
*.apk
*.aab
*.ipa
*.log
coverage/

# Secrets / local env (use EAS env vars instead)
.env*.local
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Repo noise
.git/
.vscode/
.idea/
.DS_Store
