# Copy to apps/mobile/.env.local (git-ignored) and fill in.
# The deployed SproutCue web app's API root. A phone can't reach 127.0.0.1 on your Mac;
# for local testing use your Mac's LAN address, e.g. http://192.168.1.20:3000/api
# (start the web app with `npm run dev:web -- -H 0.0.0.0` so it listens on the LAN).
EXPO_PUBLIC_API_BASE_URL=https://your-sproutcue-domain.example/api

# Same Supabase project as apps/web (publishable key only — never the service role key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional: public web address for playdate share links (https://your-domain/share/playdate/…).
# Defaults to EXPO_PUBLIC_API_BASE_URL without /api. Set it when friends can't reach your LAN address.
# EXPO_PUBLIC_SITE_URL=https://your-sproutcue-domain.example
