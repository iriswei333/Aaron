{
  "expo": {
    "name": "SproutCue",
    "slug": "sproutcue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sproutcue",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sproutcue.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:app.sproutcue.com",
        "applinks:app.sproutcue.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFEBDC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sproutcue.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.sproutcue.com",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFAF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SproutCue uses your location to find playgrounds, playdates, family events, and story times near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SproutCue uses the photos you choose to make private picture books, stories, and play ideas for your child, or to share in a family chat.",
          "cameraPermission": "SproutCue uses the camera when you take a photo of your child or a toy for Play Studio, or a photo to share in a family chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#e86f3d",
          "defaultChannel": "ai-creations"
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-sharing",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBV9XKRy0oj4Ox-E2zoxV3ShPwuwxSo8sI"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c331cf4-e4df-4f48-b4ad-081a1644705d"
      }
    },
    "owner": "irisweis-team"
  }
}
