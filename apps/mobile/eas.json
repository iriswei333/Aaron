{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://app.sproutcue.com/api",
        "EXPO_PUBLIC_SITE_URL": "https://app.sproutcue.com"
      }
    },
    "preview": {
