NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

GOOGLE_PLACES_API_KEY=
# Browser-restricted key for the Google Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side only. Required when generating a family picture-book page.
OPENAI_API_KEY=
PICTURE_BOOK_IMAGE_MODEL=gpt-image-2.5-sunburst
PICTURE_BOOK_IMAGE_QUALITY=high

# Optional. Extra browser origins allowed to call /api (comma-separated).
# Native iOS/Android requests do not need this; Expo web dev (localhost:8081) is allowed automatically outside production.
CORS_ALLOWED_ORIGINS=

# Optional. Only needed if "Enhanced push security" is turned on for the Expo project
# that sends push notifications to the mobile app (expo.dev → project → Credentials).
EXPO_ACCESS_TOKEN=
