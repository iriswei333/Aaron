{
  "name": "sproutcue-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sproutcue/web",
    "dev:web": "npm run dev --workspace @sproutcue/web",
    "dev:web:lan": "npm run dev:lan --workspace @sproutcue/web",
    "dev:mobile": "npm run start --workspace @sproutcue/mobile",
    "build": "npm run build --workspace @sproutcue/web",
    "start": "npm run start --workspace @sproutcue/web",
    "test": "npm run test --workspace @sproutcue/shared && npm run test --workspace @sproutcue/web",
    "lint": "npm run lint --workspace @sproutcue/web",
    "storybook": "npm run storybook --workspace @sproutcue/web",
    "social:weekly": "npm run social:weekly --workspace @sproutcue/web"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
